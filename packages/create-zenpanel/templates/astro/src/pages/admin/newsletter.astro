---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Newsletter">
  <div id="layout-root"></div>
  <div id="page-content" hidden></div>
</AdminLayout>

<script>
  import { mountAdminLayout } from "../../scripts/layout.js";
  import { renderResourcePage } from "../../scripts/resource.js";
  import { adminNewsletter } from "../../scripts/data.js";

  mountAdminLayout({ title: "Newsletter" });
  renderResourcePage(document.getElementById("page-content"), {
    title: "Newsletter",
    resourceLabel: "subscriber",
    searchPlaceholder: "Search email, source...",
    titleLabel: "Email",
    metaLabel: "Preferences",
    titleIsEmail: true,
    statusLabels: {
      published: "Subscribed",
      draft: "Pending",
      archived: "Unsubscribed"
    },
    items: adminNewsletter,
  });
</script>
