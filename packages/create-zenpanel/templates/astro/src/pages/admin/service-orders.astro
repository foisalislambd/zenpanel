---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Service orders">
  <div id="layout-root"></div>
  <div id="page-content" hidden></div>
</AdminLayout>

<script>
  import { mountAdminLayout } from "../../scripts/layout.js";
  import { renderResourcePage } from "../../scripts/resource.js";
  import { adminServiceOrders } from "../../scripts/data.js";

  mountAdminLayout({ title: "Service orders" });
  renderResourcePage(document.getElementById("page-content"), {
    title: "Service orders",
    resourceLabel: "order",
    searchPlaceholder: "Search customer, service, order ID...",
    titleLabel: "Order",
    metaLabel: "Amount",
    statusLabels: {
      published: "Completed",
      draft: "Pending",
      archived: "Refunded"
    },
    items: adminServiceOrders,
  });
</script>
