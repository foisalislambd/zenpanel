---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "ZenPanel" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#465fff" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content="Admin UI shell - Astro preview. No backend." />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <noscript>ZenPanel needs JavaScript enabled to run.</noscript>
    <slot />
    <script>
      import { initTheme } from "../scripts/theme.js";
      initTheme();
    </script>
  </body>
</html>
