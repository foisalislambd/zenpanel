{
  "name": "zenpanel",
  "version": "1.0.1",
  "private": true,
  "description": "ZenPanel — open-source admin UI shell. Scaffold with npm create zenpanel.",
  "license": "MIT",
  "author": "Foisal Islam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Foisalislambd/zenpanel.git"
  },
  "bugs": {
    "url": "https://github.com/Foisalislambd/zenpanel/issues"
  },
  "homepage": "https://github.com/Foisalislambd/zenpanel#readme",
  "keywords": [
    "admin",
    "dashboard",
    "nextjs",
    "react",
    "vite",
    "astro",
    "tailwindcss",
    "admin-panel",
    "create-zenpanel"
  ],
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w create-zenpanel",
    "dev:cli": "npm run dev -w create-zenpanel",
    "typecheck": "npm run typecheck -w create-zenpanel",
    "create-zenpanel": "node packages/create-zenpanel/dist/index.js",
    "template": "node scripts/template.mjs",
    "template:list": "node scripts/template.mjs list",
    "dev:nextjs": "node scripts/template.mjs nextjs",
    "dev:react": "node scripts/template.mjs react",
    "dev:preact": "node scripts/template.mjs preact",
    "dev:solid": "node scripts/template.mjs solid",
    "dev:svelte": "node scripts/template.mjs svelte",
    "dev:vue": "node scripts/template.mjs vue",
    "dev:html": "node scripts/template.mjs html",
    "dev:astro": "node scripts/template.mjs astro",
    "dev:angular": "node scripts/template.mjs angular"
  }
}
